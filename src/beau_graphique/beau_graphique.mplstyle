# ============================================================
# beau_graphique.mplstyle — Style UX-first pour matplotlib
# Usage : plt.style.use('chemin/vers/beau_graphique.mplstyle')
# Note  : couleurs en tuples RGB (0-1) car les hex ne sont
#         pas supportés dans tous les environnements mplstyle
# ============================================================

# --- Fond & axes ---
figure.facecolor        : (0.969, 0.973, 0.988)
axes.facecolor          : (0.969, 0.973, 0.988)
axes.edgecolor          : (0.816, 0.827, 0.871)
axes.linewidth          : 0.8
axes.grid               : True
axes.spines.top         : False
axes.spines.right       : False
axes.spines.left        : True
axes.spines.bottom      : True

# --- Grille lisible sans distraire ---
grid.color              : (0.886, 0.894, 0.933)
grid.linewidth          : 0.7
grid.linestyle          : --
grid.alpha              : 0.8

# --- Couleurs des séries ---
axes.prop_cycle         : cycler('color', ['4361EE', 'F72585', '4CC9F0', '7209B7', '3A0CA3', 'F3722C', '43AA8B', '90BE6D'])

# --- Typographie ---
font.family             : DejaVu Sans
font.size               : 11
axes.titlesize          : 15
axes.titleweight        : bold
axes.titlepad           : 14
axes.labelsize          : 11
axes.labelcolor         : (0.176, 0.184, 0.243)
axes.labelpad           : 8

# --- Ticks ---
xtick.color             : (0.420, 0.435, 0.522)
ytick.color             : (0.420, 0.435, 0.522)
xtick.labelsize         : 10
ytick.labelsize         : 10
xtick.major.size        : 0
ytick.major.size        : 0

# --- Lignes ---
lines.linewidth         : 2.4
lines.solid_capstyle    : round

# --- Marqueurs ---
lines.markersize        : 7
lines.markeredgewidth   : 0

# --- Barres ---
patch.linewidth         : 0

# --- Légende ---
legend.frameon          : True
legend.framealpha       : 0.92
legend.edgecolor        : (0.816, 0.827, 0.871)
legend.fontsize         : 10
legend.title_fontsize   : 11
legend.borderpad        : 0.6
legend.handlelength     : 1.4

# --- Figure ---
figure.figsize          : 10, 5.6
figure.dpi              : 120
figure.titlesize        : 17
figure.titleweight      : bold

# --- Sauvegarde ---
savefig.dpi             : 180
savefig.bbox            : tight
savefig.pad_inches      : 0.2
savefig.facecolor       : (0.969, 0.973, 0.988)
